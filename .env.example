# Copiez ce fichier en .env et renseignez vos clés Supabase
# (Project Settings > API dans votre dashboard Supabase)

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clé PRIVÉE — Project Settings > API > service_role. Ne JAMAIS la publier
# ni la mettre dans du code accessible au navigateur. Nécessaire pour :
# suppression de compte, invitation d'administrateurs.
# En production (Vercel), ajoutez-la dans Project Settings > Environment
# Variables — jamais dans ce fichier une fois commité.
SUPABASE_SERVICE_ROLE_KEY=

# Laissez vide pour le site web. Pour l'app mobile Capacitor uniquement,
# définissez l'URL de production avant "npm run cap:sync" :
# NUXT_PUBLIC_API_BASE_URL=https://retrouva.vercel.app
NUXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Paiements en ligne (page /don) — renseignez ci-dessous les identifiants
# reçus de chaque opérateur. Tant qu'une section reste vide, le bouton
# "Payer en ligne" correspondant reste masqué et la page /don continue de
# fonctionner en mode instructions manuelles (numéro à copier / USSD), sans
# aucune régression.

# Orange Money — Web Payment API (developer.orange.com > mes applications)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# MTN Mobile Money — API Collections (momodeveloper.mtn.com)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# 'sandbox' pour tester, puis l'identifiant d'environnement fourni par MTN
# une fois votre demande de mise en production approuvée.
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Wave — Business API (wave.com > Portail Business > Développeur > Clés API)
WAVE_API_KEY=
# Généré en activant "request signing" sur la clé API ci-dessus. Sert à
# vérifier l'authenticité des webhooks reçus sur /api/dons/wave-webhook —
# sans cette variable, les webhooks Wave sont refusés (401) par sécurité.
WAVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Reçu de don (e-mail + SMS) — envoyé automatiquement dès qu'un don passe au
# statut "confirmé" (admin ou paiement en ligne). Tant que ces variables
# restent vides, le don se confirme normalement mais aucun reçu n'est
# envoyé (le donateur connecté reçoit quand même une notification in-app).

# Resend (resend.com) — reçu par e-mail. "from" doit être une adresse d'un
# domaine vérifié dans votre compte Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RETROUVA <dons@votre-domaine.ci>

# Passerelle SMS générique — reçu par SMS. Adaptez server/utils/envoyerSms.js
# si le format attendu par votre fournisseur diffère de { to, message }.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=RETROUVA

# ---------------------------------------------------------------------------
# Notifications push réelles (app mobile Capacitor) — Console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé
# privée, puis collez tout le JSON obtenu ici sur une seule ligne. Laissez
# vide pour continuer avec les notifications in-app uniquement (déjà
# fonctionnelles sans ce réglage).
FIREBASE_SERVICE_ACCOUNT_JSON=
