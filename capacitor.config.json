{
  "appId": "ci.retrouva.app",
  "appName": "RETROUVA",
  "webDir": ".output/public",
  "bundledWebRuntime": false,
  "backgroundColor": "#FBF8F2",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0B3D24",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B3D24"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
